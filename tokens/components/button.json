        "$description": ""
      },
      "background-hover": {
        "$value": "{surface.dark}",
        "$type": "color",
        "$description": ""
      },
      "foreground-hover": {
        "$value": "{text.on-dark}",
        "$type": "color",
        "$description": ""
      },
      "border-hover": {
        "$value": "{text.on-dark}",
        "$type": "color",
        "$description": ""
      }
    },
    "secondary": {
      "background": {
        "$value": "{surface.dark}",
        "$type": "color",
        "$description": ""
      },
      "foreground": {
        "$value": "{text.on-dark}",
        "$type": "color",
        "$description": ""
      },
      "border": {
        "$value": "{text.on-dark}",
        "$type": "color",
        "$description": ""
      },
      "background-hover": {
        "$value": "{surface.light}",
        "$type": "color",
        "$description": ""
      },
      "foreground-hover": {
        "$value": "{text.on-light}",
        "$type": "color",
        "$description": ""
      },
      "border-hover": {
        "$value": "{text.on-light}",
        "$type": "color",
        "$description": ""
